{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fulcrum-governance.github.io/fulcrum-proofs/schemas/control_matrix.schema.json",
  "title": "Compliance Control Matrix",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["control_id", "regulation_clause", "test_id", "evidence_artifact", "result"],
    "properties": {
      "control_id": {"type": "string"},
      "regulation_clause": {"type": "string"},
      "test_id": {"type": "string"},
      "evidence_artifact": {"type": "string"},
      "result": {"type": "string", "enum": ["pass", "fail", "incomplete", "waived"]}
    },
    "additionalProperties": false
  }
}
