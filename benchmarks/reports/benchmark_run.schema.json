{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fulcrum-governance.github.io/fulcrum-proofs/schemas/benchmark_run.schema.json",
  "title": "Benchmark Run Report",
  "type": "object",
  "required": [
    "run_id",
    "data_source",
    "runner",
    "hardware_profile",
    "fulcrum_commit",
    "contracts_snapshot_sha",
    "commit",
    "env",
    "workload",
    "durability_mode",
    "samples",
    "p50",
    "p95",
    "p99",
    "ci95",
    "errors"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "data_source": {"type": "string", "enum": ["real", "simulated"]},
    "runner": {"type": "string", "enum": ["k6", "ghz", "hybrid"]},
    "hardware_profile": {
      "type": "object",
      "required": ["platform", "arch", "cpu_count"],
      "properties": {
        "platform": {"type": "string"},
        "arch": {"type": "string"},
        "cpu_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "fulcrum_commit": {"type": "string"},
    "contracts_snapshot_sha": {"type": "string"},
    "commit": {"type": "string"},
    "env": {"type": "string"},
    "workload": {"type": "string"},
    "durability_mode": {"type": "string", "enum": ["durable_governed", "non_durable_fast", "finops_sensitivity"]},
    "samples": {"type": "integer", "minimum": 1},
    "p50": {"type": "number", "minimum": 0},
    "p95": {"type": "number", "minimum": 0},
    "p99": {"type": "number", "minimum": 0},
    "ci95": {
      "type": "object",
      "required": ["low", "high"],
      "properties": {
        "low": {"type": "number"},
        "high": {"type": "number"}
      },
      "additionalProperties": false
    },
    "errors": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
